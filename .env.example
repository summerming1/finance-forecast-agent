# Optional. The project runs without LLM keys using ReplayLLM fixtures.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=

# DashScope OpenAI-compatible example:
# OPENAI_API_KEY=your_dashscope_api_key
# OPENAI_MODEL=qwen-plus
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#
# GLM/Z.ai OpenAI-compatible example:
# OPENAI_API_KEY=your_glm_api_key
# OPENAI_MODEL=glm-5.2
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional tracking config. SQLite MLflow backend and local DVC remote work out of the box.
MLFLOW_TRACKING_URI=sqlite:///projects/finance_agent/mlflow.db
DVC_REMOTE_URL=projects/finance_agent/dvc_remote_storage

# Optional data settings.
DEFAULT_MARKET_DATA_PROVIDER=plotly
DEFAULT_TICKERS=AAPL,MSFT,GOOG,AMZN,NFLX,META,SPY,QQQ

# R6 trusted local workspace authority: point at the original reviewed registry.
# FFA_WORKSPACE_STATE_DB=/absolute/path/to/runtime.sqlite3
# FFA_WORKSPACE_TENANT=default

# B1: explicit bounded HTTP policy. No automatic model/billing changes.
# Connect/read idle limits differ from the hard total logical-call deadline.
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=180
LLM_CALL_DEADLINE=240
LLM_HTTP_ATTEMPTS=2
# Campaign CLI: --max-http-requests 48 --max-provider-seconds 3600
# Monetary cost stays unknown until trustworthy pricing/usage is available.
